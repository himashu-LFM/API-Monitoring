// Prisma schema — Postgres on AWS RDS.
// DATABASE_URL lives in .env.local (gitignored). See .env.example for the
// exact RDS connection-string format (SSL is required by RDS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL is the pooled connection (port 6543, used by the
  // app); DIRECT_URL is the direct connection (port 5432, used for migrations).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// MEMBER = signed in but only sees the Welcome page.
/// ADMIN  = full access to the whole dashboard.
enum Role {
  MEMBER
  ADMIN
}

// ─── Auth.js (NextAuth) core models ───────────────────────────────
// These four models are the shape the Prisma adapter expects. The only
// custom addition is `role` on User.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
