# ─────────────────────────────────────────────────────────────
# API Monitor — environment configuration
# Copy this file to `.env.local` and fill in the values.
# Leave a value blank to mark that service as "Not configured".
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Zyte (Zyte API dashboard stats) ──────────────────────────
# API key = your Zyte *dashboard* API key (not the Zyte API key).
# ORG_ID  = organization id from the Zyte dashboard URL.
# LIMIT   = your plan's request/quota cap (APIs don't return this).
# RENEWAL = billing reset date, ISO format YYYY-MM-DD.
ZYTE_API_KEY=
ZYTE_ORG_ID=
ZYTE_LIMIT=
ZYTE_RENEWAL=

# ── Google (Google Cloud API usage) ──────────────────────────
# Google has no single "usage" API — point USAGE_URL at the exact
# endpoint for the API/metric you want (e.g. a Cloud Monitoring
# time-series query). API_KEY or BEARER is used for auth.
# JSON_PATH = dot-path to the numeric usage value in the response.
GOOGLE_API_KEY=
GOOGLE_BEARER=
GOOGLE_USAGE_URL=
GOOGLE_USAGE_JSON_PATH=
GOOGLE_LIMIT=
GOOGLE_RENEWAL=

# ── Hootsuite (OAuth2 — API-call quota only) ─────────────────
# ACCESS_TOKEN = OAuth2 bearer token for your approved app.
# NOTE: Hootsuite only exposes API-CALL quota (via response
# headers), not subscription usage. RENEWAL is your plan reset.
HOOTSUITE_ACCESS_TOKEN=
HOOTSUITE_RENEWAL=

# ── Decodo (help.decodo.com/api-reference) ───────────────────
# API_KEY       = generate from dashboard.decodo.com -> API Keys.
#                 Sent as-is in the `Authorization` header (no
#                 "Bearer "/"Basic " prefix — confirmed from docs).
# PROXY_TYPE    = which subscription/proxy product you actually have:
#                 residential_proxies, mobile_proxies, datacenter_proxies,
#                 isp_proxies. Check dashboard.decodo.com to see which.
#
# IMPORTANT — confirmed by testing (valid key -> HTTP 200 + `[]` for
# every proxy type, vs 401 for a bad/missing key): Decodo's own docs
# state the Public API does NOT support datacenter/isp proxies at all.
# For those two, subscriptions/traffic REST calls always come back
# empty — that's Decodo's limitation, not a config mistake here.
#
# residential_proxies / mobile_proxies (REST works):
#   TRAFFIC_FIELD = numeric field name to sum from the traffic-stats
#     response (POST /api/v2/statistics/traffic). Decodo's docs don't
#     list this response's exact fields, so leave blank first — the
#     app reports the raw response once so you can see the real field
#     name (e.g. "traffic"), then set it. GET /v2/subscriptions
#     reliably gives traffic_limit + valid_until (no field-guessing
#     needed for those two).
#
# datacenter_proxies / isp_proxies (REST doesn't work — use webhooks):
#   WEBHOOK_TOKEN = any random string you choose (treat as a password).
#     Register this URL in dashboard.decodo.com -> Settings -> Webhooks:
#       https://<your-public-domain>/api/webhooks/decodo/<WEBHOOK_TOKEN>
#     and enable the "traffic_usage" webhook. Decodo only fires it at
#     80% and 100% usage — not continuously — so this gives threshold
#     alerts, not a live running percentage. Local dev needs a public
#     URL (e.g. ngrok) for Decodo's servers to reach you.
#   RENEWAL = ANY one known renewal/reset date, ISO YYYY-MM-DD — past
#     or future, doesn't matter. There's no renewal webhook, so this is
#     the one manual input, but you set it ONCE, ever: the app rolls it
#     forward by BILLING_CYCLE to find the next real occurrence, so it
#     never needs re-entering after each cycle.
#   BILLING_CYCLE = Daily | Weekly | Monthly | Annual (default Monthly).
DECODO_API_KEY=
DECODO_PROXY_TYPE=residential_proxies
DECODO_TRAFFIC_FIELD=
DECODO_WEBHOOK_TOKEN=
DECODO_RENEWAL=
DECODO_BILLING_CYCLE=Monthly
