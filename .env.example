# ─────────────────────────────────────────────────────────────
# API Monitor — environment configuration
# Copy this file to `.env.local` and fill in the values.
# Leave a value blank to mark that service as "Not configured".
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Email alerts (Gmail SMTP) ────────────────────────────────
# The alert checker runs server-side (GET /api/cron/check), NOT in the
# browser — an alert that only fires while the dashboard is open is
# useless. It emails you when a service crosses a usage threshold.
#
# GMAIL_USER         = the Gmail address that sends the mail.
# GMAIL_APP_PASSWORD = a Google **App Password** (16 chars) from
#   myaccount.google.com/apppasswords — requires 2FA on the account.
#   Your normal Gmail password will NOT work.
# ALERT_EMAIL_TO     = where alerts are delivered (can be the same address).
# ALERT_THRESHOLDS   = comma-separated usage %s. These are the server's
#   source of truth — the checkboxes in Settings/Alert Configuration are
#   browser-side only and the checker can't read them.
# CRON_SECRET        = any random string; required to call /api/cron/check
#   once deployed, so the endpoint isn't publicly triggerable.
#
# You get at most ONE email per threshold per billing cycle (state is kept
# in .data/alert-state.json), so a 15-minute schedule won't spam you.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_THRESHOLDS=50,75,90,100
CRON_SECRET=

# ── Zyte (docs.zyte.com/zyte-api/usage/stats.html) ───────────
# Confirmed schema, GET https://zyte-api-stats.zyte.com/api/stats
# ?organization_id=...&start_time=...&end_time=... -> results[0].cost_microusd_total
#
# API_KEY = your Zyte dashboard/STATS API key — docs are explicit this
#   is NOT the same key you use for scraping requests. Find it in the
#   Zyte dashboard (Stats page / API key settings). Sent as HTTP Basic
#   auth username with an empty password (the app does this for you).
# ORG_ID  = numeric organization id from the dashboard URL, e.g.
#   https://app.zyte.com/o/123456 -> 123456.
# LIMIT   = a USD budget, not a request count — Zyte plans cap $ spend,
#   not requests (confirmed: zyte.com/blog/new-spending-controls...).
#   Check your Zyte dashboard's "Spending Alerts" page for a configured
#   Spending Limit and use that; if none is set there either, this is
#   just your own monitoring budget, not an amount Zyte enforces.
# RENEWAL = ANY one known billing date (past or future) — set once,
#   same auto-rolling behaviour as Decodo's renewal date.
# BILLING_CYCLE = Daily | Weekly | Monthly | Annual (default Monthly).
ZYTE_API_KEY=
ZYTE_ORG_ID=
ZYTE_LIMIT=
ZYTE_RENEWAL=
ZYTE_BILLING_CYCLE=Monthly

# ── Google (Google Cloud API usage) ──────────────────────────
# Google has no single "usage" API — point USAGE_URL at the exact
# endpoint for the API/metric you want (e.g. a Cloud Monitoring
# time-series query). API_KEY or BEARER is used for auth.
# JSON_PATH = dot-path to the numeric usage value in the response.
GOOGLE_API_KEY=
GOOGLE_BEARER=
GOOGLE_USAGE_URL=
GOOGLE_USAGE_JSON_PATH=
GOOGLE_LIMIT=
GOOGLE_RENEWAL=

# ── Hootsuite (OAuth2 — API-call quota only) ─────────────────
# ACCESS_TOKEN = OAuth2 bearer token for your approved app.
# NOTE: Hootsuite only exposes API-CALL quota (via response
# headers), not subscription usage. RENEWAL is your plan reset.
HOOTSUITE_ACCESS_TOKEN=
HOOTSUITE_RENEWAL=

# ── Decodo (help.decodo.com/api-reference) ───────────────────
# API_KEY       = generate from dashboard.decodo.com -> API Keys.
#                 Sent as-is in the `Authorization` header (no
#                 "Bearer "/"Basic " prefix — confirmed from docs).
# PROXY_TYPE    = which subscription/proxy product you actually have:
#                 residential_proxies, mobile_proxies, datacenter_proxies,
#                 isp_proxies. Check dashboard.decodo.com to see which.
#
# IMPORTANT — confirmed by testing (valid key -> HTTP 200 + `[]` for
# every proxy type, vs 401 for a bad/missing key): Decodo's own docs
# state the Public API does NOT support datacenter/isp proxies at all.
# For those two, subscriptions/traffic REST calls always come back
# empty — that's Decodo's limitation, not a config mistake here.
#
# residential_proxies / mobile_proxies (REST works):
#   TRAFFIC_FIELD = numeric field name to sum from the traffic-stats
#     response (POST /api/v2/statistics/traffic). Decodo's docs don't
#     list this response's exact fields, so leave blank first — the
#     app reports the raw response once so you can see the real field
#     name (e.g. "traffic"), then set it. GET /v2/subscriptions
#     reliably gives traffic_limit + valid_until (no field-guessing
#     needed for those two).
#
# datacenter_proxies / isp_proxies (REST doesn't work — use webhooks):
#   WEBHOOK_TOKEN = any random string you choose (treat as a password).
#     Register this URL in dashboard.decodo.com -> Settings -> Webhooks:
#       https://<your-public-domain>/api/webhooks/decodo/<WEBHOOK_TOKEN>
#     and enable the "traffic_usage" webhook. Decodo only fires it at
#     80% and 100% usage — not continuously — so this gives threshold
#     alerts, not a live running percentage. Local dev needs a public
#     URL (e.g. ngrok) for Decodo's servers to reach you.
#   RENEWAL = ANY one known renewal/reset date, ISO YYYY-MM-DD — past
#     or future, doesn't matter. There's no renewal webhook, so this is
#     the one manual input, but you set it ONCE, ever: the app rolls it
#     forward by BILLING_CYCLE to find the next real occurrence, so it
#     never needs re-entering after each cycle.
#   BILLING_CYCLE = Daily | Weekly | Monthly | Annual (default Monthly).
DECODO_API_KEY=
DECODO_PROXY_TYPE=residential_proxies
DECODO_TRAFFIC_FIELD=
DECODO_WEBHOOK_TOKEN=
DECODO_RENEWAL=
DECODO_BILLING_CYCLE=Monthly

# ── SadCaptcha (sadcaptcha.com/api/v1/swagger-ui) ────────────
# Confirmed schema, GET https://www.sadcaptcha.com/api/v1/license/credits
# ?licenseKey=<key> -> { "credits": <number> }
#
# LICENSE_KEY = your SadCaptcha license key. Sent as a QUERY PARAM (not
#   a header) — that's how SadCaptcha's own API is built, not our choice.
# TOTAL_CREDITS = this is a prepaid-credit system: the API only reports
#   credits REMAINING, never the total you originally topped up, and
#   there's no renewal date (you top up manually, whenever). Set this to
#   your last top-up amount to see a real "% used"; leave blank to just
#   see the raw remaining-credits number without a meaningful %.
SADCAPTCHA_LICENSE_KEY=
SADCAPTCHA_TOTAL_CREDITS=
