# ─────────────────────────────────────────────────────────────
# API Monitor — environment configuration
# Copy this file to `.env.local` and fill in the values.
# Leave a value blank to mark that service as "Not configured".
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Auth / Database (login + roles) ──────────────────────────
# Supabase Postgres. Get both strings from your Supabase project:
#   Dashboard → Connect (top bar) → ORMs / Prisma tab.
# DATABASE_URL — the POOLED connection (Transaction, port 6543). Used by the app.
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL   — the DIRECT connection (Session, port 5432). Used for migrations.
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# AUTH_SECRET — random secret for signing sessions. Generate with:
#   npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth 2.0 credentials from Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → "Web application").
# Authorized redirect URI must be:
#   http://localhost:3000/api/auth/callback/google   (dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ADMIN_EMAILS — comma-separated @listenfirstmedia.com emails that are
# auto-promoted to ADMIN on sign-in (bootstrap the first admins here).
# Everyone else starts as MEMBER (Welcome page only).
ADMIN_EMAILS=

# ── Zyte (Zyte API dashboard stats) ──────────────────────────
# API key = your Zyte *dashboard* API key (not the Zyte API key).
# ORG_ID  = organization id from the Zyte dashboard URL.
# LIMIT   = your plan's request/quota cap (APIs don't return this).
# RENEWAL = billing reset date, ISO format YYYY-MM-DD.
ZYTE_API_KEY=
ZYTE_ORG_ID=
ZYTE_LIMIT=
ZYTE_RENEWAL=

# ── Google Cloud (API usage via Cloud Monitoring) ────────────
# "Used" is read from the Cloud Monitoring API with a service account.
# Google has no fixed subscription cap, so LIMIT is set manually (the
# number you want "remaining" measured against / to alert on).
#   PROJECT_ID = your GCP project id (e.g. api-monitor-470912)
#   SA_KEY     = the FULL service-account JSON key on ONE line.
#                Create: IAM & Admin → Service Accounts → Add key → JSON.
#                Grant the service account the "Monitoring Viewer" role.
#   SERVICE    = which API to monitor (e.g. compute.googleapis.com).
#                Leave blank to sum request_count across all APIs.
#   LIMIT      = quota/budget cap you want to track against.
#   RENEWAL    = billing reset date, YYYY-MM-DD.
GOOGLE_PROJECT_ID=
GOOGLE_SA_KEY=
GOOGLE_SERVICE=
GOOGLE_LIMIT=
GOOGLE_RENEWAL=

# ── Hootsuite (API-call quota via response headers) ──────────
# Hootsuite exposes API-CALL quota only (100,000 calls/day) via the
# X-Account-Quota-Used response header. Auth is OAuth2 — use a refresh
# token so the scheduled job never hits an expired access token.
# Create an app at https://developer.hootsuite.com → My Apps.
#   CLIENT_ID / CLIENT_SECRET = your approved app's OAuth2 credentials
#   REFRESH_TOKEN = obtained once from the OAuth2 authorization flow
#   LIMIT   = daily call cap (default 100000)
#   RENEWAL = plan reset date, YYYY-MM-DD
HOOTSUITE_CLIENT_ID=
HOOTSUITE_CLIENT_SECRET=
HOOTSUITE_REFRESH_TOKEN=
HOOTSUITE_LIMIT=100000
HOOTSUITE_RENEWAL=

# ── Decodo (public API key) ──────────────────────────────────
# API_KEY   = Decodo public API key (used as Basic auth token).
# USAGE_URL = exact traffic/subscription endpoint from your Decodo
#             docs (base is https://api.decodo.com/v1). Required.
# JSON_PATH = dot-path to used-traffic value; LIMIT = plan cap.
DECODO_API_KEY=
DECODO_USAGE_URL=
DECODO_USAGE_JSON_PATH=
DECODO_LIMIT=
DECODO_RENEWAL=
